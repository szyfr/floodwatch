// Pampanga Flood Watch - data model.
// Mirrors the entities the design bundle describes: cities/municipalities,
// citizen flood reports with crowd votes, DRRM broadcast alerts, safe zones
// and PAGASA-style river gauges.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Prisma 7 takes the connection string from prisma7.config.ts, not from here.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum Role {
  RESIDENT
  OFFICIAL
}

/// Water depth buckets offered on the submit form.
enum WaterLevel {
  ANKLE
  KNEE
  CAR_DEEP
  IMPASSABLE
}

enum AlertPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertType {
  FLOOD_WARNING
  EVACUATION_ORDER
  ROAD_CLOSURE
  GENERAL
}

/// Broadcast target: the whole province, or the LGUs listed in AlertArea.
enum AlertScope {
  PROVINCE
  AREAS
}

enum ZoneType {
  SHELTER
  EVACUATION_POINT
  HIGH_GROUND
}

/// PAGASA alarm ladder for river gauges.
enum AlarmLevel {
  NORMAL
  FIRST
  SECOND
  THIRD
}

enum GaugeTrend {
  RISING
  STEADY
  FALLING
}

enum VoteValue {
  UP
  DOWN
}

// ---------------------------------------------------------------- models

/// A Pampanga city or municipality. `slug` is the stable id used in URLs,
/// socket rooms and the map ("sf", "candaba", …).
model Lgu {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  lat                 Float
  lng                 Float
  isCity              Boolean  @default(false)
  registeredResidents Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users      User[]
  reports    FloodReport[]
  zones      SafeZone[]
  gauges     RiverGauge[]
  alertAreas AlertArea[]
  routes     EvacuationRoute[]
  pushSubs   PushSubscription[]

  @@index([name])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         Role     @default(RESIDENT)
  /// Office a DRRM account speaks for, shown on the reports they file.
  organisation String?
  language     String   @default("en")
  lguId        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lgu             Lgu               @relation(fields: [lguId], references: [id], onDelete: Restrict)
  reports         FloodReport[]     @relation("ReportAuthor")
  verifiedReports FloodReport[]     @relation("ReportVerifier")
  votes           ReportVote[]
  alerts          Alert[]
  alertDismissals AlertDismissal[]
  zones           SafeZone[]
  routes          EvacuationRoute[]
  pushSubs        PushSubscription[]

  @@index([lguId])
}

/// One citizen sighting of flooding at a point.
model FloodReport {
  id            String     @id @default(cuid())
  lguId         String
  locationName  String
  description   String?
  /// Tagalog rendering, when one exists (seeded content ships bilingual).
  descriptionTl String?
  waterLevel    WaterLevel
  lat           Float
  lng           Float
  photoUrl      String?
  /// Idempotency key from the offline queue, so a retry cannot file the same
  /// sighting twice.
  clientId      String?
  /// Denormalised tallies, kept in step with ReportVote inside a transaction.
  upvotes       Int        @default(0)
  downvotes     Int        @default(0)
  verifiedAt    DateTime?
  verifiedById  String?
  authorId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  /// Soft delete - the map drops it, the audit trail keeps it.
  deletedAt     DateTime?

  lgu        Lgu          @relation(fields: [lguId], references: [id], onDelete: Cascade)
  author     User?        @relation("ReportAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  verifiedBy User?        @relation("ReportVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  votes      ReportVote[]

  @@unique([authorId, clientId])
  @@index([lguId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([deletedAt])
  @@index([authorId])
}

/// One vote per person per report; switching direction updates in place.
model ReportVote {
  id        String    @id @default(cuid())
  reportId  String
  userId    String
  value     VoteValue
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  report FloodReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
}

/// A DRRM broadcast. `scope = PROVINCE` reaches everyone; `AREAS` reaches the
/// LGUs joined through AlertArea.
model Alert {
  id        String        @id @default(cuid())
  title     String
  titleTl   String?
  message   String
  messageTl String?
  type      AlertType
  priority  AlertPriority
  scope     AlertScope    @default(PROVINCE)
  /// Office shown to residents, e.g. "PDRRMO Pampanga".
  sentBy    String
  authorId  String?
  /// Idempotency key from the broadcast form. A double-tapped Broadcast was
  /// only untidy while alerts stayed on screen; it rings every phone in the
  /// province twice now, and two ids will not collapse under one notification
  /// tag. Same pattern as FloodReport.clientId.
  clientId  String?
  active    Boolean       @default(true)
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  areas      AlertArea[]
  dismissals AlertDismissal[]
  dispatch   PushDispatch?

  @@unique([authorId, clientId])
  @@index([createdAt(sort: Desc)])
  @@index([active])
}

model AlertArea {
  alertId String
  lguId   String

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  lgu   Lgu   @relation(fields: [lguId], references: [id], onDelete: Cascade)

  @@id([alertId, lguId])
  @@index([lguId])
}

/// Per-person dismissal, so one resident clearing an alert does not clear it
/// for the province.
model AlertDismissal {
  alertId     String
  userId      String
  dismissedAt DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([alertId, userId])
  @@index([userId])
}

/// Shelter, evacuation point or high ground residents can head for.
model SafeZone {
  id            String    @id @default(cuid())
  lguId         String
  name          String
  type          ZoneType
  lat           Float
  lng           Float
  capacity      Int?
  occupancy     Int       @default(0)
  contactName   String?
  contactPhone  String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  lgu       Lgu   @relation(fields: [lguId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([lguId])
  @@index([deletedAt])
}

/// A river gauge station and its latest observation.
model RiverGauge {
  id            String     @id @default(cuid())
  code          String     @unique
  lguId         String
  name          String
  lat           Float
  lng           Float
  readingMetres Float
  alarmLevel    AlarmLevel @default(NORMAL)
  trend         GaugeTrend @default(STEADY)
  /// Metres per hour; negative when falling.
  deltaPerHour  Float      @default(0)
  observedAt    DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  lgu      Lgu            @relation(fields: [lguId], references: [id], onDelete: Cascade)
  readings GaugeReading[]

  @@index([lguId])
}

/// Observation history, so trend and delta are derived rather than asserted.
model GaugeReading {
  id            String     @id @default(cuid())
  gaugeId       String
  readingMetres Float
  alarmLevel    AlarmLevel
  observedAt    DateTime   @default(now())

  gauge RiverGauge @relation(fields: [gaugeId], references: [id], onDelete: Cascade)

  @@index([gaugeId, observedAt(sort: Desc)])
}

/// Phase 2 in the design - the model exists so route drawing has somewhere to
/// land; the panel still shows the empty state until drawing ships.
model EvacuationRoute {
  id          String    @id @default(cuid())
  lguId       String
  name        String
  /// GeoJSON LineString coordinates: [[lng, lat], …]
  path        Json
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  lgu       Lgu   @relation(fields: [lguId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([lguId])
}

/// A Web Push subscription: one browser profile on one device. The DEVICE is
/// the subscriber, not the account - a resident who never signs in still gets
/// evacuation orders, and someone carrying a phone and a barangay tablet tunes
/// each of them separately.
model PushSubscription {
  id           String   @id @default(cuid())
  /// The push service's URL, and the only identity this table has. Unique on
  /// its own and never paired with userId: Postgres treats NULLs as distinct,
  /// so an anonymous device would duplicate freely. Clearing site data mints a
  /// new endpoint and the old one starts answering 410. Checked against
  /// lib/push/endpoints.ts before it is stored, because this column is a URL
  /// the server POSTs to on every broadcast.
  endpoint     String   @unique
  /// RFC 8291 key material from PushSubscription.getKey(), base64url. With the
  /// endpoint these are a bearer capability, so they never reach a DTO.
  p256dh       String
  auth         String
  /// The one area this device wants area-targeted orders for. Required, not
  /// nullable: an unaddressed row receives no AREAS broadcast at all, which is
  /// exactly the shape a barangay evacuation order takes, and silence is the
  /// one failure nobody thinks to report. Seeded from the session's home area
  /// or the current `?lgu=`, and always shown in words on the drawer row.
  lguId        String
  /// Null for a device that has never signed in, and re-nullable, because
  /// deleting an account must not quietly stop that handset hearing an order.
  /// Same reasoning as FloodReport.authorId.
  userId       String?
  /// Interface language when this device last asserted itself. The service
  /// worker cannot read the app's language store, so the body arrives already
  /// written. Taken from the device's own store rather than User.language,
  /// which is a best-effort fire-and-forget shadow.
  language     String   @default("en")
  /// Support only ("it stopped ringing after the phone updated").
  userAgent    String?
  /// Refreshed every time the app re-asserts this subscription. A row nobody
  /// has re-asserted in months is a phone in a drawer.
  lastSeenAt   DateTime @default(now())
  /// Consecutive soft failures. PUSH_FAILURE_LIMIT retires the row and any
  /// success resets it. A 404/410 skips this and deletes at once; a 401/403
  /// never touches it, because that is our key being wrong, not their phone.
  failureCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lgu  Lgu   @relation(fields: [lguId], references: [id], onDelete: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([lguId])
  @@index([userId])
}

/// One broadcast's fan-out. This is the whole of the "queue": a keyset cursor
/// and a finished flag. There is no job library here for the same reason there
/// is no Redis - one process, on purpose (DEPLOYMENT.md).
model PushDispatch {
  id         String    @id @default(cuid())
  alertId    String    @unique
  /// Last PushSubscription.id attempted. Paging is keyset on the primary key,
  /// so a resume after a restart cannot ring anyone the first pass covered.
  cursor     String?
  matched    Int       @default(0)
  delivered  Int       @default(0)
  /// Endpoints that answered 404 or 410 and were deleted. Not a failure - a
  /// phone that was wiped, or an app someone uninstalled.
  gone       Int       @default(0)
  failed     Int       @default(0)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([finishedAt])
}
