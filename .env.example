# Local development environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/floodwatch?schema=public"

# Signing key for the session cookie. Replace in any shared environment.
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Custom server (Next + Socket.io share one HTTP listener).
PORT=3000
HOSTNAME=localhost
NEXT_PUBLIC_SOCKET_PATH=/ws

# Report photos. Unset = local disk at ./var/uploads, which is what a
# development machine wants: no bucket, no credentials. Set S3_BUCKET in
# production and photos go to S3 instead - the public URL stays
# /uploads/<uuid>.<ext> either way. Credentials come from the EC2 instance
# role via IMDS; never put AWS keys here.
# S3_BUCKET=floodwatch-uploads-xxxxxxxx
# AWS_REGION=ap-southeast-1
# S3_UPLOAD_PREFIX=uploads/

# Photo moderation via Rekognition. Off unless this is exactly "on", and it only
# runs when S3_BUCKET is set, since it inspects the stored object. It FAILS OPEN:
# an outage, timeout or missing permission logs and lets the photo through,
# because during a flood a blocked report is worse than an unmoderated photo.
#
# Every category blocks by default. REKOGNITION_ALLOW_CATEGORIES is the escape
# hatch - "Visually Disturbing" covers injuries and wreckage and "Violence"
# reads rescue scenes, so both will reject legitimate flood reports. Add the
# ones you need to allow and restart; no rebuild, none of these are NEXT_PUBLIC_.
# REKOGNITION_MODERATION=on
# REKOGNITION_MIN_CONFIDENCE=80
# REKOGNITION_ALLOW_CATEGORIES=Visually Disturbing,Violence
# REKOGNITION_TIMEOUT_MS=5000

# Place search on the picker maps. ON by default - unlike photo moderation, this
# needs no credential and no bucket, and a reporter benefits on day one. Set
# GEOCODE_PROVIDER=off to disable it: the search box then offers only the
# twenty-two cities and municipalities, never reaches the network, and the map
# picker and the raw lat/lng inputs are untouched either way.
#
# The provider is Photon (komoot), over OpenStreetMap data, no API key. It is
# always called from the server: a browser cannot set a User-Agent, and a
# key-based provider would otherwise end up in the client bundle. Answers are
# cached in process and rate limited per account; if komoot throttles this box,
# point GEOCODE_BASE_URL at a self-hosted Photon with a Philippines extract -
# that is the whole migration. Search FAILS SOFT: an outage returns no places
# and the reporter still drops the pin on the map.
# GEOCODE_PROVIDER=photon
# GEOCODE_BASE_URL=https://photon.komoot.io
# GEOCODE_TIMEOUT_MS=4000

# Map tiles come from Stadia Maps and need nothing here. They authenticate by
# domain allowlist - add the site's hostname under Properties in the Stadia
# dashboard. localhost and 127.0.0.1 are exempt, so development needs no setup.

# --- Push notifications (Web Push / VAPID) ---
# Generate the pair once with:  npx web-push generate-vapid-keys
#
# With all three absent the feature is inert: no drawer row, no worker
# registration, no dispatch rows, and `bun run build` still succeeds.
#
# ROTATING THE PAIR IS A ONE-WAY DOOR. The public key is baked into every
# subscription a browser mints, so a new pair makes every push service answer
# 403 and no phone in the province works again until each resident opts in
# afresh. Generate once, back the pair up with the database, never rotate
# casually.
#
# Read at runtime, NOT at build time - deliberately not NEXT_PUBLIC_, which
# would be inlined by `next build` and a build never runs server.ts.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Must be a mailto: or https: URL - Apple's push service is strict about this.
# VAPID_SUBJECT="mailto:drrm@example.gov.ph"

# Shared secret for POST /api/internal/push/sweep, which the systemd timer pokes
# once a minute to resume a fan-out that a restart interrupted.
# PUSH_SWEEP_SECRET=""
