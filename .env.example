# Local development environment.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/floodwatch?schema=public"

# Signing key for the session cookie. Replace in any shared environment.
AUTH_SECRET="generate-with-openssl-rand-hex-32"

# Custom server (Next + Socket.io share one HTTP listener).
PORT=3000
HOSTNAME=localhost
NEXT_PUBLIC_SOCKET_PATH=/ws

# Map tiles come from Stadia Maps, authenticated by domain allowlist — add the
# site's hostname under Properties in the Stadia dashboard. localhost and
# 127.0.0.1 need nothing, so leave this unset in development. Set it only where
# a domain cannot be allowlisted: it is inlined into the client bundle at build
# time and is therefore public, so restrict it to this property.
# NEXT_PUBLIC_STADIA_API_KEY=
